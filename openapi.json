{"openapi":"3.1.0","info":{"title":"RouteRiff Route Audit API","version":"2026-10-14","description":"Read-only geographic sanity-check API for multi-stop travel routes. The API is public and requires no account. Results are planning heuristics, not live routing or travel advice."},"servers":[{"url":"https://routeriff.vercel.app"}],"paths":{"/api/audit":{"get":{"summary":"Audit a route from compact coordinate points","description":"Audit a route using pipe-separated latitude,longitude,name points. Use reliable coordinates for 2–12 stops.","parameters":[{"name":"points","in":"query","required":true,"schema":{"type":"string"}},{"name":"days","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":365}}],"responses":{"200":{"description":"Route audit result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuditResponse"}}}},"400":{"description":"Structured request error","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"405":{"description":"Structured request error","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}},"operationId":"auditRouteGet"},"post":{"summary":"Audit a route from structured coordinates","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["points"],"properties":{"days":{"type":"integer","minimum":1,"maximum":365},"points":{"type":"array","minItems":2,"maxItems":12,"items":{"$ref":"#/components/schemas/Point"}}}}}}},"responses":{"200":{"description":"Route audit result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuditResponse"}}}},"400":{"description":"Structured request error","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"405":{"description":"Structured request error","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}},"operationId":"auditRoutePost","description":"Audit 2–12 route stops with coordinates. The API does not fetch locations or verify current schedules."}}},"components":{"schemas":{"Point":{"type":"object","required":["lat","lon"],"properties":{"name":{"type":"string","maxLength":90},"lat":{"type":"number","minimum":-90,"maximum":90},"lon":{"type":"number","minimum":-180,"maximum":180},"country":{"type":"string","maxLength":90}}},"AuditResponse":{"type":"object","properties":{"ok":{"type":"boolean"},"version":{"type":"string"},"route":{"type":"object"},"audit":{"type":"object","properties":{"score":{"type":"integer","minimum":35,"maximum":99},"verdict":{"type":"string","enum":["Looks reasonable","Needs a second look","Rework before booking"]},"distance_km":{"type":"number"},"estimated_travel_hours":{"type":"number"},"average_travel_hours_per_day":{"type":["number","null"]},"long_jump_flags":{"type":"integer"},"backtracking_flags":{"type":"integer"},"largest_detour":{"type":["object","null"]},"legs":{"type":"array","items":{"type":"object"}}}},"limitations":{"type":"array","items":{"type":"string"}},"source_url":{"type":"string","format":"uri"}}},"Problem":{"type":"object","required":["type","title","status","detail","code"],"properties":{"type":{"type":"string","format":"uri-reference","example":"about:blank"},"title":{"type":"string"},"status":{"type":"integer"},"detail":{"type":"string"},"code":{"type":"string"}}}}}}